# A few tests to make sure the solver works OK

## INLINE: solve-formula
# Takes:
# * ${1} equation
# * ${2} result
# * ${3} left boundary
# * ${4} right boundary
# * ${5} initialization (x is OK most of the times)
# * ${6} expected residual precision
# * ${7} expected difference with the solution

generate-dataset ${3} ${4} ${5}
solve ${1}
apply-formula y2=${1} /extra-columns=1
assert $stats.y2_0dev ${6} \
  /info=eq=${1} /info=sol=${2} /info=left=${3} \
  /info=right=${4} /info=init=${5} /info=test=solve-res

apply-formula y=${2}
S 1 0
assert $stats.y_0dev ${7} \
  /info=eq=${1} /info=sol=${2} /info=left=${3} \
  /info=right=${4} /info=init=${5} /info=test=solve-diff
## INLINE END

@ inline:solve-formula y**2-x   sqrt(x)  0     1    x  1e-6 1e-6
@ inline:solve-formula sin(y)-x asin(x)  -0.99 0.99 x  1e-6 1e-6
@ inline:solve-formula y**2-x   -sqrt(x) 0     1    -x 1e-6 1e-6


# OK, this is obviously wrong ;-)
# @ inline:solve-formula sin(y)-x sin(x)  -0.99 0.99 x 1e-6 1e-6


