generate-dataset 0 10 0
sim-implicit y**5-a*x parameters/implicit-1.params 0 /prec-relative=1e-10
apply-formula y-=(0.6*x)**0.2
assert $stats.y_0dev 5e-16

generate-dataset 0 10 0
sim-implicit y**5-a*x;fit=b*y**5 parameters/implicit-1.params 0 /prec-relative=1e-10 /override=a=3;b=2
apply-formula y-=6*x
assert '$stats["y_norm"]' 2e-13

########################################

# Something on the line of what we are doing for CODHs, see
# Merrouch, et al, Electrochimica Acta, 2017
# DOI: 10.1016/j.electacta.2017.03.114

## INLINE: transport.rb
def itrprt(cb, km, nFAm, nFAmu)
  cg = cb - km * (1 + nFAmu/nFAm)
  c0 = 0.5*(cg + (cg**2 + 4*km*cb)**0.5)
  return nFAmu * km/(1 + km/c0)
end
## INLINE END

ruby-run inline:transport.rb
generate-dataset 0 10
sim-arb itrprt(s,km,nFAm,nFAmu) /with=s:1,exp parameters/transport-1.params 0

# The equivalent equation is the following, using y as the
# concentration at 0
sim-implicit nFAm*(s-y)-nFAmu*km*y/(y+km);fit=nFAm*(s-y) /with=s:1,exp parameters/transport-1.params 0
S 1 0

assert $stats.y_0dev 4e-13