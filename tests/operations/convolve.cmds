# Analytical formula: convolution of two gaussians
## INLINE: two-gaussians
generate-dataset -10 10 exp(-${1}*x**2) /samples=${3}
convolve exp(-${2}*x**2)
apply-formula y-=sqrt(PI/(${1}+${2}))*exp(-${1}*${2}/(${1}+${2})*x**2)

assert $stats.y_0dev ${4} /info=test=convolve-two-gaussians \
  /info=g1=${1} /info=g2=${2} /info=samples=${3}
## INLINE END

@ inline:two-gaussians 2.0 3.0 1000 1e-15
@ inline:two-gaussians 4.0 7.0 1000 1e-15
@ inline:two-gaussians 4.0 7.0 10000 2e-15
@ inline:two-gaussians 7.0 4.0 1000 1e-15

# Other check: conservation of the integral, if one convolves by something
# of unity integral

## INLINE: test-conservation
generate-dataset -10 10 if(abs(x)>1);0;else;((i-i%2)/2)%2;end /samples=${2}
eval $int=$stats.y_int
convolve ${1}*exp(-x*${1}) /symmetric=false
assert abs($int-$stats.y_int) ${3} /info=test=convolve-conservation \
  /info=time=${1} /info=samples=${2}
## INLINE END

@ inline:test-conservation 1   1000  3e-5
@ inline:test-conservation 5   1000  1e-3
@ inline:test-conservation 30  1000  1e-4
@ inline:test-conservation 100 1000  1e-4
@ inline:test-conservation 1e3 1000  1e-4
@ inline:test-conservation 1e3 10000 1e-4
@ inline:test-conservation 1e4 1000  1e-4

# TODO: go more ?

# test singularity at 0 by simulating a reversible CV
generate-dataset 0 10 0.5-0.2*abs(x-5) /samples=30000
apply-formula /extra-columns=1 y2=y;e=exp(F*y/(R*298));y=e/(1+e)
diff
convolve x**-0.5 /symmetric=false
apply-formula x,y2=y2,x
echem-peaks /output=false /accumulate=delta_x
pop
# at 298K, the difference should be close to 0.057 mV
assert $nstats.delta_x_first-0.057 0.001
