# The script takes (optionally) one data file, which doesn't have to
# exist, and reads the latex file to preprocess from standard input.
#
# * the selection works on the keys of the results, in a
#   key=value;key2=value manner
# * the command  \testvalue{selection}{key} just gives the value
#   corresponding to the key
# * the command \testrows{selection}{key1,key2,...} makes columns with
#   the values

require 'yaml'
require 'optparse'

$res = nil

opts = OptionParser.new do |opts|
  opts.on("-r", "--results-only XXX",
          "saves results only to the file"
         ) do |x|
    $res = open(x, 'w')
  end
end

opts.parse!(ARGV)

$datasets = []
$dataset_names = []
$named = false
for f in ARGV
  name = ""
  if f =~ /([^:]+):(.+)/
    f = $2
    name = $1
    $named = true
  end
  begin
    file = open(f, 'r')
    $datasets << YAML.load(file)
    $dataset_names << name
  rescue
    $stderr.puts "Couldn't load #{f}"
  end
end

if $datasets.size == 0
  $main_dataset = []
else
  $main_dataset = $datasets.first
end

def find_all_items(selection)
  rv = []
  $datasets.size.times do |i|
    its = find_items(selection, $datasets[i])
    for it in its
      it["dataset-idx"] = i
    end
    rv += its
  end
  return rv
end


def find_items(selection, dataset)
  ls = selection.split(/\s*;\s*/)
  keys = {}
  rv = []
  for l in ls
    ll = l.split(/\s*=\s*/)
    if ll.size != 2
      $stderr.puts "Invalid selection rule: #{ll}"
    end
    keys[ll[0]] = ll[1]
  end
  # p keys
  for d in dataset
    # p d
    # p keys
    found = true
    for k in keys.keys
      if ! d.key? k
        found = false
        break
      end
      val = d[k].to_s
      # puts "Key; '#{k}' -> '#{val}'"
      if val != keys[k]
        found = false
        break
      end
    end
    if found
      rv << d
    end
  end
  return rv
end

def decorate_key(el, spec)
  cmd = nil
  if spec =~ /(.*)@(.*)/
    k = $1
    cmd = $2
  else
    k = spec
  end
  if el.key? k
    val = el[k]
    if val.respond_to?(:gsub)
      val.gsub!(/_/,'\_')
    end
    if cmd
      return "\\#{cmd}{#{el[k]}}"
    else
      return el[k]
    end
  else
    return "missing"
  end
end

# Makes a full tabular
# The specifications are:
# * a selection; several selections can be separated by
#   a ||
# * a series of column names separated by |, and also possibly by || (see below)
# * a series of key specs, separated by ',' or '|' or '||'
#   -> what's left of | (only one) designates the "common" part
#   -> the || introduces a new set of the "variable" part for the next
#      selection
#
# Only this
def make_tabular(sel, cols, values)

  # First the selections
  sels = sel.split(/\s*\|\|\s*/)

  v_specs = values.split(/\s*\|\|\s*/)
  if v_specs.size != sels.size
    return "Mismatch in selection vs columns spec sizes"
  end

  f_s = v_specs[0].split(/\s*\|\s*/)
  if f_s.size > 2
    return "Too many specification of common parameters"
  end
  common_specs = f_s[0].split(/\s*,\s*/)

  v_specs[0] = if f_s.size > 1
                 f_s[1]
               else
                 ""
               end
  local_specs = v_specs.map do |x|
    x.split(/\s*,\s*/)
  end

  # p common_specs
  # p local_specs

  # OK, so common_specs are the ones that should be shared and will be
  # matched, local_specs the ones that are just displayed but not matched

  # Then the column names, first splitting 
  c_nms = cols.split(/\s*\|\|\s*/)
  if c_nms.size != sels.size
    return "Mismatch in selection vs column names sizes"
  end

  c_nms2 = c_nms.map do |x|
    x.split(/\s*\|\s*/)
  end
  # Now take out the common part
  common_names = c_nms2[0][0..common_specs.size-1]
  if local_specs[0].size > 0
    local_names = [c_nms2[0][common_specs.size..]]
  else
    local_names = []
  end
  if c_nms2.size > 1
    local_names += c_nms2[1..]
  end

  # p common_names
  # p local_names

  # Computing the total number of columns
  overall_columns = common_specs.size
  local_begs = []
  bottom_names = [''] * common_specs.size

  all_col_names = common_names.dup
  $datasets.size.times do |idx|
    local_begs << []
    local_specs.each { |a|
      local_begs[idx] << overall_columns
      overall_columns += a.size
      nm = "\\texttt{#{$dataset_names[idx]}}"
      bottom_names += [nm] * a.size
    }
    all_col_names += local_names
  end
  col_string = "c" * overall_columns
  col_string[0] = "l"

  # Let's gather the data
  items = sels.map do |x|
    find_all_items(x)
  end

  rows = []
  sels.size.times do |idx|
    for el in items[idx]
      commons = common_specs.map {|s| decorate_key(el, s) }
      loc = local_specs[idx].map {|s| decorate_key(el, s) }
      fnd = nil
      for r in rows
        if r[0..commons.size-1] == commons
          # Then we have found one
          fnd = r
        end
      end
      if not fnd
        fnd = [""] * overall_columns
        fnd[0..commons.size-1] = commons
        rows << fnd
      end
      if loc.size > 0
        fnd[local_begs[el["dataset-idx"]][idx]..local_begs[el["dataset-idx"]][idx]+loc.size-1] = loc
      end
    end
  end
 
  # OK, so now let's just write the tabular
  # p common_names
  # p common_specs
  
  rv = "\\begin{tabular}{#{col_string}}\n\\toprule\n"
  rv << all_col_names.join(" & ")
  rv << "\\\\\n\\midrule\n"
  for r in rows
    rv << r.join(" & ") << "\\\\\n"
  end
  if $named
    rv << "\\midrule\n#{bottom_names.join(" & ")}\\\\\n"
  end
  rv << "\\bottomrule\n\\end{tabular}"

  return rv
end

preamble = true
in_test = false

for l in STDIN
  write = false
  if l =~ /\\begin\{document\}/
    preamble = false
    write = true
  elsif l =~ /\\end\{document\}/
    write = true
  elsif l =~ /\\begin\{testresult\}/
    in_test = true
  elsif l =~ /\\end\{testresult\}/
    in_test = false
    write = true
  end
  if $res && (preamble || in_test || write)
    $res.puts l.gsub('a4paper', 'a3paper,landscape=false')
  end
  l.gsub!(/\\testtabular\{([^}]+)\}\{([^}]+)\}\{([^}]+)\}/) do |x|
    make_tabular($1, $2, $3)
  end
  puts l
end
