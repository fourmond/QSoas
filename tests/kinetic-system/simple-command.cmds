# In this file, we're testing the command kinetic-system, as opposed
# to most of the other files that just use the kinetic-system fit (and
# sim- command)

# Basic check
generate-dataset 0 7
kinetic-system simple.qsys c0_A=1;c0_B=0;k1=2;km1=1
apply-formula 'y-= (2.0/3.0) * exp(-3*x) + 1/3.0'
assert '$stats["y_norm"]' 1e-11
assert $meta.c0_A-1 0

# Same thing but with several strings
generate-dataset 0 7
kinetic-system simple.qsys c0_A=1 c0_B=0 k1=2 km1=1
apply-formula 'y-= (2.0/3.0) * exp(-3*x) + 1/3.0'
assert '$stats["y_norm"]' 1e-11
assert $meta.k1-2 0


## INLINE: inclusion.rb
k1=3;km1=k1
## INLINE END

# Now we're checking we can include things from files and use formulas
generate-dataset 0 7
kinetic-system simple.qsys c0_A=1;c0_B=0;k1=2;km1=1;@include(inline:inclusion.rb)
apply-formula 'y-= (1.0/2.0) * exp(-6*x) + 1/2.0'
assert '$stats["y_norm"]' 1e-9
